{
  "name": "choda-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/spike-server.ts --format esm --target node22 --out-dir dist",
    "test": "vitest run",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3",
    "pino": "10.3.1",
    "libsodium-wrappers": "0.8.4",
    "yaml": "2.8.4",
    "undici": "8.2.0"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "vitest": "4.1.5",
    "typescript": "5.9.3",
    "@types/node": "22.15.29",
    "@biomejs/biome": "1.9.4"
  }
}
